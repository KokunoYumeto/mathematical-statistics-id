# Reproducibility evidence and reader artifacts are byte-addressed.  Never let
# checkout-platform newline conversion alter those blobs.
authority/** -text
source/** -text
backend/** -text
build/** -text

# Repository prose, control files, scripts, and workflows are canonical LF.
*.md text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
00_control/*.json text eol=lf
00_control/*.jsonl text eol=lf
00_control/*.csv text eol=lf
requirements.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
